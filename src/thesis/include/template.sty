%%
%% template
%%
%% Preamble of the thesis. Requires XeLaTeX or LuaLaTeX (tectonic uses XeTeX).
%% Load it right after \documentclass; page geometry and PDF metadata belong
%% in main.tex. Works with both chapter-based (report, book) and section-based
%% (article) classes.
%%


%
% language and fonts
%


% character protrusion (margin kerning); must precede babel, whose czech
% module otherwise breaks microtype's patch for list items
\RequirePackage{microtype}

% babel next, main language last
\RequirePackage[czech,main=english]{babel}

% amsmath and mathtools must precede unicode-math; the two silenced warnings
% only announce that unicode-math takes over mathtools' brackets and colons
\RequirePackage{amsmath}
\RequirePackage{mathtools}
\RequirePackage{amsthm}
% (one key per warning: the option parser splits a braced list at its comma)
\RequirePackage[
    warnings-off = mathtools-colon,
    warnings-off = mathtools-overbracket,
]{unicode-math}

% integral limits above and below in display style (amsmath's intlimits
% option is ignored by unicode-math); must precede \setmathfont
\removenolimits{\int\iint\iiint\iiiint\oint\oiint\oiiint}

% New Computer Modern, the OpenType successor of Computer/Latin Modern
\setmainfont{NewCM10}[
    Extension      = .otf,
    UprightFont    = *-Regular,
    BoldFont       = *-Bold,
    ItalicFont     = *-Italic,
    BoldItalicFont = *-BoldItalic,
]
\setsansfont{NewCMSans10}[
    Extension      = .otf,
    UprightFont    = *-Regular,
    BoldFont       = *-Bold,
    ItalicFont     = *-Oblique,
    BoldItalicFont = *-BoldOblique,
]
\setmonofont{NewCMMono10}[
    Extension      = .otf,
    UprightFont    = *-Regular,
    BoldFont       = *-Bold,
    ItalicFont     = *-Italic,
    BoldItalicFont = *-BoldOblique,
]
\setmathfont{NewCMMath-Regular.otf}

% quotation marks: \enquote{...}
\RequirePackage[autostyle]{csquotes}


%
% general packages
%


% graphics
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{tikz-cd}
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

% floats and captions
\RequirePackage{float}
\RequirePackage{placeins}
\RequirePackage{subcaption}

% tables
\RequirePackage{booktabs}
\RequirePackage{makecell}
\RequirePackage{multirow}

% lists; shortlabels keeps the enumerate-package syntax, e.g. [(a)]
\RequirePackage[shortlabels]{enumitem}

% line spacing
\RequirePackage{setspace}

% physical quantities and units: \qty{3}{\giga\hertz}, \unit{\ohm}
\RequirePackage{siunitx}

% derivatives: \odv{f}{x}, \pdv{f}{x,y}, \odif{x}
\RequirePackage{derivative}

% spacing after \ie, \eg, \cf
\RequirePackage{xspace}

% hyperref goes after the packages above and before cleveref and algorithm
\RequirePackage[psdextra]{hyperref} % psdextra: math (\alpha, ...) in bookmarks
\hypersetup{
    colorlinks=true, % false: boxed links; true: colored links
    linkcolor=blue!70!black, % color of internal links
    citecolor=red!70!black, % color of links to bibliography
    filecolor=blue!70!black, % color of file links
    urlcolor=blue!70!black, % color of external links
    bookmarksnumbered=true,
}

% algorithms: algorithm float + algpseudocode (algorithmicx) environment; the
% float is defined here, as algorithm.sty does it, because algorithm.sty is
% Latin-1 encoded and makes XeTeX warn about an invalid UTF-8 byte
\floatstyle{ruled}
\newfloat{algorithm}{tbp}{loa}
\floatname{algorithm}{Algorithm}
\floatstyle{plain}
\newcommand*{\listofalgorithms}{\listof{algorithm}{List of Algorithms}}
\RequirePackage{algpseudocode}

% references with automatic names: \cref{thm:main} -> "Theorem 2.1"
\RequirePackage[capitalise,nameinlink]{cleveref}

% custom elmag colors
\definecolor{elmagGray}{RGB}{245, 245, 245}
\definecolor{PairedA}{RGB}{166, 206, 227}
\definecolor{PairedB}{RGB}{ 31, 120, 180}
\definecolor{PairedC}{RGB}{178, 223, 138}
\definecolor{PairedD}{RGB}{ 41, 128,  35}
\definecolor{PairedE}{RGB}{251, 154, 153}
\definecolor{PairedF}{RGB}{182,  21,  22}
\definecolor{PairedG}{RGB}{253, 191, 111}
\definecolor{PairedH}{RGB}{255, 127,   0}
\definecolor{PairedI}{RGB}{202, 178, 214}
\definecolor{PairedJ}{RGB}{106,  61, 154}
\definecolor{PairedK}{RGB}{255, 255, 153}
\definecolor{PairedL}{RGB}{177,  89,  40}


%
% typesetting penalties
%


% for avoiding \mbox{} everywhere...
\relpenalty=10000
\binoppenalty=10000

% avoid singletons
\widowpenalty=10000
\clubpenalty=10000
\displaywidowpenalty=10000


%
% theorems
%


\@ifundefined{c@chapter}
    {\newtheorem{theorem}{Theorem}[section]%
     \numberwithin{equation}{section}%
     \numberwithin{algorithm}{section}}
    {\newtheorem{theorem}{Theorem}[chapter]%
     \numberwithin{equation}{chapter}%
     \numberwithin{algorithm}{chapter}}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}

\theoremstyle{definition}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{assumption}[theorem]{Assumption}
\newtheorem{example}[theorem]{Example}

\theoremstyle{remark}
\newtheorem{remark}[theorem]{Remark}

\theoremstyle{plain}

% end-of-proof square on its own line, flush right (\fill outstretches the
% \parfillskip), and kept on the same page as the last line of the proof;
% \qedhere in a final display still puts it on the display's line
\DeclareRobustCommand*{\qed}{%
    \ifmmode
        \mathqed
    \else
        \par\nobreak\noindent\hspace*{\fill}\qedsymbol
    \fi
}


%
% math
%


% paired delimiters: \abs{x} natural size, \abs*{x} auto-sized,
% \abs[\big]{x} manual size
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\DeclarePairedDelimiterX{\inner}[2]{\langle}{\rangle}{#1, #2}
% open interval ]a, b[; typing ] and [ directly gives them closing and opening
% spacing, which breaks e.g. the spacing of \times in ]0, a[ \times ]0, b[
\DeclarePairedDelimiterX{\openint}[2]{\rbrack}{\lbrack}{#1, #2}

% operators
\DeclareMathOperator{\RE}{Re} % real part of...
\DeclareMathOperator{\IM}{Im} % imaginary part of...
\DeclareMathOperator{\tr}{tr}
\DeclareMathOperator{\rank}{rank}
\DeclareMathOperator{\diag}{diag}
\DeclareMathOperator{\spn}{span}
\DeclareMathOperator{\sgn}{sgn}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}

% basic constants, and math objects
\newcommand*{\I}{\ensuremath{\mathrm{i}}} % imaginary unit
\newcommand*{\Quot}[1]{\enquote{#1}} % quotation
\newcommand*{\D}{\mathop{}\!\mathrm{d}} % d for integral
% the outer braces keep brace-less sub/superscripts working: E_\V{x}, R_\T{in}
\newcommand*{\V}[1]{{\symbfit{#1}}} % vector
\newcommand*{\M}[1]{{\symbfup{#1}}} % matrix
\newcommand*{\TEN}[1]{{\symbfcal{#1}}} % tensor
\newcommand*{\T}[1]{{\mathrm{#1}}} % upright text (subindex, superindex,..)
\newcommand*{\UV}[1]{\hat{\V{#1}}} % unit vector
\newcommand*{\NORM}[1]{\norm*{#1}} % auto-sized norm
\newcommand*{\ABS}[1]{\abs*{#1}} % auto-sized absolute value
\newcommand*{\OP}[1]{\mathcal{#1}} % operator
